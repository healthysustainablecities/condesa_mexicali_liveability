__pycache__/
*.pyc
.ipynb_checkpoints/

# Source data is not redistributed: it can be large and licences
# often forbid it.  The metadata records where each dataset came
# from so it can be fetched again.
data/raw/*
!data/raw/.gitkeep

# Dashboard: vendored libraries and tile archives are rebuilt, not versioned.
dashboard/vendor/
dashboard/build/_work/
dashboard/data/**/*.pmtiles
# the grid rasters for the smooth surface, also rebuilt
dashboard/data/**/*.f32
dashboard/data/**/*.i32
dashboard/data/**/data_dictionary.xlsx
dashboard/data/**/data_dictionary.pdf
